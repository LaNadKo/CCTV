# Backend address visible from the Processor host.
BACKEND_URL=http://192.168.50.10:8001

# Preferred first connection flow: generate code in Console -> Processor page.
PROCESSOR_CONNECT_CODE=

# Optional stable identifiers. Leave empty for first run unless you know them.
API_KEY=
PROCESSOR_ID=
PROCESSOR_NAME=processor-1
PROCESSOR_NODE_UID=
PROCESSOR_ADVERTISED_IP=

# Runtime and media server.
PROCESSOR_RUNTIME_VOLUME=processor_runtime
MEDIA_BIND=0.0.0.0
MEDIA_PORT=8777
MEDIA_TOKEN=

# Workload.
PROCESSOR_ACCEL=auto
MAX_WORKERS=4
POLL_INTERVAL=3
HEARTBEAT_INTERVAL=30

# Detection and recording.
MOTION_THRESHOLD=25
MOTION_MIN_AREA=500
FACE_SCAN_DIVISOR=8
OVERLAY_FRAME_DIVISOR=1
FACE_MATCH_THRESHOLD=0.56
RECORDING_SEGMENT_SECONDS=60
RECORDING_UPLOAD_CONCURRENCY=2
RECORDING_UPLOAD_QUEUE_SIZE=128
RECORDING_RETENTION_DAYS=0
RECORDING_RETENTION_MAX_BYTES=0
RECORDING_MIN_FREE_BYTES=536870912
MAX_CAPTURE_PIXELS=8294400
