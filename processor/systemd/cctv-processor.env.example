# Copy to /etc/cctv-processor.env and edit values.
BACKEND_URL=http://192.168.50.10:8001
PROCESSOR_CONNECT_CODE=

# Leave API_KEY/PROCESSOR_ID empty when connecting by code.
API_KEY=
PROCESSOR_ID=
PROCESSOR_NAME=processor-linux-1
PROCESSOR_NODE_UID=
PROCESSOR_ADVERTISED_IP=

PROCESSOR_RUNTIME_DIR=/var/lib/cctv-processor
PROCESSOR_ACCEL=auto
MAX_WORKERS=4
POLL_INTERVAL=3
HEARTBEAT_INTERVAL=30

MEDIA_PORT=8777
MEDIA_TOKEN=
RECORDING_SEGMENT_SECONDS=60
FACE_SCAN_DIVISOR=8
OVERLAY_FRAME_DIVISOR=1
