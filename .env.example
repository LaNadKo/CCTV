# CCTV Console — Конфигурация
# Скопируйте в .env:  cp .env.example .env
# Или запустите install.sh — он создаст .env автоматически

DOMAIN=localhost
BACKEND_PORT=8000
ENVIRONMENT=development
POSTGRES_USER=cctv
POSTGRES_PASSWORD=cctv
POSTGRES_DB=cctv
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
PROCESSOR_API_KEY=changeme-generate-with-openssl-rand-hex-24
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=
ALLOW_DEFAULT_ADMIN=true
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
ALLOWED_HOSTS=*
ENABLE_DOCS=true
ALLOW_LEGACY_QUERY_TOKENS=false
MEDIA_TOKEN_EXPIRES_SECONDS=900
PROCESSOR_NAME=processor-1
PROCESSOR_ID=
PROCESSOR_CONNECT_CODE=
PROCESSOR_NODE_UID=
PROCESSOR_ADVERTISED_IP=
PROCESSOR_MAX_WORKERS=4
PROCESSOR_POLL_INTERVAL=3
PROCESSOR_HEARTBEAT_INTERVAL=30
PROCESSOR_MEDIA_PORT=8777
PROCESSOR_MEDIA_TOKEN=
# auto | cpu | nvidia | intel | amd | directml
PROCESSOR_ACCEL=auto
FACE_SCAN_DIVISOR=8
OVERLAY_FRAME_DIVISOR=1
RECORDING_SEGMENT_SECONDS=60
ENABLE_EMBEDDED_DETECTOR=false
DEBUG=false
TOTP_ENCRYPTION_KEY=
RECORDINGS_PATH=./data/recordings
SNAPSHOTS_PATH=./data/snapshots
