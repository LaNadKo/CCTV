# CCTV Console — Конфигурация
# Скопируйте в .env:  cp .env.example .env
# Или запустите install.sh — он создаст .env автоматически

DOMAIN=localhost
POSTGRES_USER=cctv
POSTGRES_PASSWORD=cctv
POSTGRES_DB=cctv
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
PROCESSOR_API_KEY=changeme-generate-with-openssl-rand-hex-24
ENABLE_EMBEDDED_DETECTOR=false
DEBUG=false
TOTP_ENCRYPTION_KEY=
RECORDINGS_PATH=./data/recordings
SNAPSHOTS_PATH=./data/snapshots

# RuView / WiFi DensePose
RUVIEW_BRIDGE_ENABLED=true
RUVIEW_UDP_BIND=0.0.0.0
RUVIEW_UDP_PORT=5005
RUVIEW_STALE_AFTER_SECONDS=10
RUVIEW_CSI_MIN_INTERVAL_SECONDS=0.02
RUVIEW_REQUIRE_LIVE_CSI_FOR_POSE=true
RUVIEW_NODE_IPS=
RUVIEW_UPSTREAM_ENABLED=true
RUVIEW_UPSTREAM_URLS=http://ruview-sensing:3000,http://host.docker.internal:3100
RUVIEW_UPSTREAM_TIMEOUT_SECONDS=1
RUVIEW_UPSTREAM_FORWARD_ENABLED=true
RUVIEW_UPSTREAM_UDP_HOST=ruview-sensing
RUVIEW_UPSTREAM_UDP_PORT=5005
RUVIEW_UPSTREAM_FORWARD_MIN_INTERVAL_SECONDS=0
