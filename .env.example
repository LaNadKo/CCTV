# CCTV Комплекс — пример конфигурации
# Windows: .\scripts\cctv-up.ps1 -Profile server
# Linux: ./install.sh
# Рекомендуется создавать .env через скрипт: он генерирует секреты и пароль администратора.

DOMAIN=localhost
SSL_EMAIL=admin@example.com
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_HTTPS_ENABLED=false
NGINX_CLIENT_MAX_BODY_SIZE=100m
NGINX_RELOAD_INTERVAL_SECONDS=21600
ENVIRONMENT=development
MEDIAMTX_BIND=127.0.0.1
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_HLS_PORT=8888
POSTGRES_USER=cctv
POSTGRES_PASSWORD=cctv
POSTGRES_DB=cctv
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
PROCESSOR_API_KEY=changeme-generate-with-openssl-rand-hex-24
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=
ALLOW_DEFAULT_ADMIN=true
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
ALLOWED_HOSTS=["127.0.0.1","localhost"]
ENABLE_DOCS=false
ALLOW_LEGACY_QUERY_TOKENS=false
MEDIA_TOKEN_EXPIRES_SECONDS=900
PROCESSOR_NAME=processor-1
PROCESSOR_ID=
PROCESSOR_CONNECT_CODE=
PROCESSOR_NODE_UID=
PROCESSOR_ADVERTISED_IP=
PROCESSOR_MAX_WORKERS=4
PROCESSOR_POLL_INTERVAL=3
PROCESSOR_HEARTBEAT_INTERVAL=30
PROCESSOR_MEDIA_BIND=127.0.0.1
PROCESSOR_MEDIA_PORT=8777
PROCESSOR_MEDIA_TOKEN=
# auto | cpu | nvidia | intel | amd | directml
PROCESSOR_ACCEL=auto
FACE_SCAN_DIVISOR=8
OVERLAY_FRAME_DIVISOR=1
RECORDING_SEGMENT_SECONDS=60
ENABLE_EMBEDDED_DETECTOR=false
DEBUG=false
TOTP_ENCRYPTION_KEY=
RECORDINGS_PATH=./data/recordings
SNAPSHOTS_PATH=./data/snapshots
